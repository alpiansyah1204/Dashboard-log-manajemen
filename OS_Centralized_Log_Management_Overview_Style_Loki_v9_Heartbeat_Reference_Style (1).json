    {
      "id": 120,
      "type": "table",
      "title": "APPLICATION / SERVER STATUS",
      "description": "Application groups with known, online, and no-log/down server counts.",
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 15
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOG_MANAGEMENT}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (app_group) (sum by (host,app_group) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[30d])))",
          "format": "table",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "expr": "count by (app_group) (sum by (host,app_group) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "expr": "count by (app_group) ((sum by (host,app_group) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[30d]))) unless (sum by (host,app_group) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[5m]))))",
          "format": "table",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "app_group": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "app_group": "Applications",
              "Value #A": "Total Server",
              "Value #B": "UP",
              "Value #C": "No Log / Down",
              "Time": ""
            }
          }
        }
      ],
