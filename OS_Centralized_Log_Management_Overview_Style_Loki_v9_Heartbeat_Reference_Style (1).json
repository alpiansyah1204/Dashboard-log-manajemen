    {
      "id": 1,
      "type": "stat",
      "title": "TOTAL SERVERS (INVENTORY)",
      "description": "Inventory: heartbeat seen within 30 days. Online: heartbeat received within 5 minutes. No heartbeat: inventory server with no heartbeat within 5 minutes.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOG_MANAGEMENT}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (host) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[30d])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
