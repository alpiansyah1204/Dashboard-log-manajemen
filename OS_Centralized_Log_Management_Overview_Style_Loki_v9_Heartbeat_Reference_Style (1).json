        "type": "loki",
        "uid": "${DS_LOG_MANAGEMENT}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * count(sum by (host) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[5m]))) / count(sum by (host) (count_over_time({job=\"os-logs\",environment=~\"$environment\",site=~\"$site\",app_group=~\"$app_group\",server_role=~\"$server_role\",os=~\"$os\",host=~\"$host\",ip=~\"$ip\",source=\"heartbeat\"}[30d])))",
